# --- Core ---
DATABASE_URL=postgresql+psycopg://findit:findit@localhost:5432/findit
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# --- Image storage: local | s3 ---
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# S3_BUCKET=
# S3_REGION=
# S3_PUBLIC_BASE_URL=

# --- Matching ---
# demo  = lightweight, no model downloads (colour-histogram images + hashed-keyword text). SIMULATED scores.
# real  = CLIP + SentenceTransformer (pip install -r requirements-ml.txt)
EMBEDDING_BACKEND=demo
CLIP_MODEL=clip-ViT-B-32
TEXT_MODEL=all-MiniLM-L6-v2
IMAGE_WEIGHT=0.6
TEXT_WEIGHT=0.4
MIN_MATCH_SCORE=30
MATCH_WINDOW_DAYS=30
MATCH_RADIUS_KM=5
